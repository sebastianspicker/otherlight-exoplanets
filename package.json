{
  "name": "otherlight",
  "version": "0.2.0-alpha.1",
  "description": "Otherlight: exoplanet learning and scientific modeling across transits, exomoons, and binary systems.",
  "keywords": [
    "astronomy",
    "binary-star",
    "education",
    "exomoon",
    "exoplanet",
    "photometry",
    "transit"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/otherlight.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/otherlight/issues"
  },
  "homepage": "https://github.com/sebastianspicker/otherlight#readme",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "vite --config apps/browser/vite.config.ts",
    "build": "vite build --config apps/browser/vite.config.ts",
    "build:pages": "vite build --config apps/browser/vite.config.ts --mode github-pages",
    "build:pages:site": "pnpm build:pages && node scripts/build-pages-demo.mjs dist/demo",
    "build:demo": "node scripts/build-pages-demo.mjs",
    "preview": "vite preview --config apps/browser/vite.config.ts",
    "preview:pages": "vite preview --config apps/browser/vite.config.ts --mode github-pages",
    "clean": "rm -rf dist pages-dist .vite .build .science-cache services/science/build services/science/dist services/science/*.egg-info apps/apple/Packages/*/.build apps/apple/Packages/*/.swiftpm",
    "typecheck": "tsc -p apps/browser/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && tsc -p apps/browser/tsconfig.worker.json --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:compat": "tsc6 -p apps/browser/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && tsc6 -p apps/browser/tsconfig.worker.json --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint . && prettier -c .",
    "lint:styles": "stylelint 'apps/browser/src/**/*.css'",
    "lint:shell": "shellcheck scripts/*.sh",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "ci:lint": "pnpm lint && pnpm lint:styles && pnpm lint:shell",
    "ci:typecheck": "pnpm typecheck && pnpm typecheck:compat",
    "ci:build": "pnpm build",
    "ci:verify": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:build",
    "audit:security": "pnpm audit --audit-level=moderate",
    "science:backend:check": "python3 -m compileall -q services/science/science_backend",
    "science:backend:serve": "PYTHONPATH=services/science python3 -m uvicorn science_backend.api:create_app --factory --host 127.0.0.1 --port 8765",
    "migrate:v4": "node scripts/migrate-systemparams-v4.mjs",
    "native:core:build": "swift build --package-path apps/apple/Packages/OtherlightCore",
    "native:science:build": "swift build --package-path apps/apple/Packages/OtherlightScience"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "prettier": "3.4.2",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.0.16"
  }
}
