{
  "name": "exoplanet-exomoon-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist .vite docs/audit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:self": "vitest run tests/self-tests.test.ts",
    "test:watch": "vitest",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "ci:lint": "pnpm lint",
    "ci:typecheck": "pnpm typecheck",
    "ci:test": "pnpm test",
    "ci:build": "pnpm build",
    "ci:verify": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "audit:security": "pnpm audit --audit-level=moderate",
    "audit:deps": "pnpm dlx depcheck --ignores=@vitest/coverage-v8",
    "audit:deadcode": "bash ./scripts/audit-dead-code.sh",
    "audit:full": "pnpm audit:security && pnpm audit:deps && pnpm audit:deadcode",
    "physics-regression": "vitest run tests/sim/transit-sequence-regression.test.ts tests/sim/transit-timing-tracker.test.ts tests/sim/dynamics-driven-diagnostics.test.ts",
    "scientific-calibration": "vitest run tests/benchmarks/literature-benchmarks.test.ts tests/sim/transit-timing-tracker.test.ts tests/sim/v4-native-parity.test.ts tests/perf/perf-scenarios.test.ts",
    "data:real-systems:refresh": "node scripts/fetch-real-systems-snapshot.mjs",
    "migrate:v4": "node scripts/migrate-systemparams-v4.mjs",
    "literature-benchmarks": "vitest run tests/benchmarks/literature-benchmarks.test.ts",
    "didactics-acceptance": "vitest run tests/didactics/didactics-acceptance.test.ts tests/didactics/hint-levels.test.ts",
    "perf-smoke": "vitest run tests/perf/perf-smoke.test.ts",
    "migration-regression": "vitest run tests/scripts/migration-regression.test.ts tests/scripts/migrate-systemparams-v4.test.ts tests/scripts/migrate-systemparams-v4-cli.test.ts",
    "smoke:served": "bash ./scripts/smoke-served-app.sh",
    "capture:github-screenshots": "node ./scripts/capture-github-screenshots.mjs"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "brace-expansion": "5.0.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  }
}
