{
  "name": "otherlight",
  "version": "0.2.0-alpha.1",
  "description": "Otherlight: exoplanet learning and scientific modeling across transits, exomoons, and binary systems.",
  "keywords": [
    "astronomy",
    "binary-star",
    "education",
    "exomoon",
    "exoplanet",
    "photometry",
    "transit"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/otherlight.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/otherlight/issues"
  },
  "homepage": "https://github.com/sebastianspicker/otherlight#readme",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.4.0"
  },
  "knip": {
    "entry": [
      "scripts/assemble-apple-screenshot-tour.mjs",
      "demo/app.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "vite build",
    "build:demo": "node scripts/build-pages-demo.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist pages-dist coverage test-results playwright-report blob-report .vite .vitest .vitest-attachments .nyc_output .ruff_cache .build docs/audit .science-cache science_backend/.pytest_cache science_backend/.ruff_cache science_backend/science_backend/__pycache__ science_backend/tests/__pycache__ science_backend/build science_backend/dist science_backend/*.egg-info native-apple/Packages/*/.build native-apple/Packages/*/.swiftpm && rm -f .DS_Store docs/.DS_Store",
    "typecheck": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:compat": "tsc6 -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "deadcode": "knip",
    "duplicates": "jscpd --min-lines 10 --min-tokens 100 --threshold 0.25 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "hygiene:public": "node scripts/check-public-surface.mjs",
    "hygiene:docs": "node scripts/check-code-documentation.mjs",
    "hygiene:swift-docs": "node scripts/check-swift-documentation.mjs",
    "ci:lint": "pnpm hygiene:public && pnpm hygiene:docs && pnpm hygiene:swift-docs && pnpm physics-registry && pnpm lint",
    "ci:typecheck": "pnpm typecheck && pnpm typecheck:compat",
    "ci:test": "pnpm test",
    "ci:build": "pnpm build",
    "ci:verify": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "audit:security": "pnpm audit --audit-level=moderate",
    "physics-registry": "node scripts/check-physics-registry.mjs",
    "science:backend:check": "python3 -m compileall -q science_backend/science_backend",
    "science:backend:serve": "PYTHONPATH=science_backend python3 -m uvicorn science_backend.api:create_app --factory --host 127.0.0.1 --port 8765",
    "science:backend:test": "PYTHONPATH=science_backend python3 -m pytest science_backend/tests",
    "science:verify": "node scripts/check-physics-registry.mjs && vitest run tests/science",
    "data:real-systems:refresh": "node scripts/fetch-real-systems-snapshot.mjs",
    "migrate:v4": "node scripts/migrate-systemparams-v4.mjs",
    "native:fixtures": "node scripts/export-native-parity-fixtures.mjs",
    "smoke:served": "bash ./scripts/smoke-served-app.sh",
    "capture:tour:web": "node ./scripts/capture-github-screenshots.mjs",
    "capture:tour:web:live": "node ./scripts/capture-github-screenshots.mjs --live-scientific",
    "capture:tour:web:static": "node ./scripts/capture-github-screenshots.mjs --static-build",
    "capture:github-screenshots": "pnpm capture:tour:web",
    "capture:github-screenshots:live": "pnpm capture:tour:web:live"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^25.5.0",
    "eslint": "10.1.0",
    "jsdom": "29.1.1",
    "prettier": "3.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "jscpd": "5.0.12",
    "knip": "6.27.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.0.16",
    "vitest": "4.1.1"
  }
}
