{
  "name": "otherlight",
  "version": "0.2.0-alpha.1",
  "description": "Otherlight: exoplanet learning and scientific modeling across transits, exomoons, and binary systems.",
  "keywords": [
    "astronomy",
    "binary-star",
    "education",
    "exomoon",
    "exoplanet",
    "photometry",
    "transit"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/otherlight.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/otherlight/issues"
  },
  "homepage": "https://github.com/sebastianspicker/otherlight#readme",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.4.0"
  },
  "knip": {
    "entry": [
      "apps/browser/tests/**/*.test.ts",
      "apps/demo/app.js",
      "scripts/**/*.{js,mjs}"
    ],
    "project": [
      "apps/browser/src/**/*.ts",
      "apps/browser/tests/**/*.ts",
      "scripts/**/*.{js,mjs}"
    ],
    "ignoreBinaries": [
      "swift"
    ]
  },
  "scripts": {
    "dev": "vite --config apps/browser/vite.config.ts",
    "start": "vite preview --config apps/browser/vite.config.ts",
    "build": "vite build --config apps/browser/vite.config.ts",
    "build:demo": "node scripts/build-pages-demo.mjs",
    "preview": "vite preview --config apps/browser/vite.config.ts",
    "clean": "rm -rf dist pages-dist coverage test-results .vite .vitest .vitest-attachments .nyc_output .pytest_cache .ruff_cache .build docs/audit .science-cache services/science/.pytest_cache services/science/.ruff_cache services/science/science_backend/__pycache__ services/science/tests/__pycache__ services/science/build services/science/dist services/science/*.egg-info apps/apple/Packages/*/.build apps/apple/Packages/*/.swiftpm && rm -f .DS_Store docs/.DS_Store",
    "typecheck": "tsc -p apps/browser/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:compat": "tsc6 -p apps/browser/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "deadcode": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "duplicates": "jscpd --min-lines 10 --min-tokens 100 --threshold 0.25 apps/browser/src",
    "test": "vitest run --config apps/browser/vitest.config.ts",
    "test:watch": "vitest --config apps/browser/vitest.config.ts",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "hygiene:public": "node scripts/check-public-surface.mjs",
    "hygiene:docs": "node scripts/check-code-documentation.mjs",
    "hygiene:swift-docs": "node scripts/check-swift-documentation.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "ci:lint": "pnpm hygiene:public && pnpm hygiene:docs && pnpm hygiene:swift-docs && pnpm architecture:check && pnpm physics-registry && pnpm lint",
    "ci:typecheck": "pnpm typecheck && pnpm typecheck:compat",
    "ci:test": "pnpm test",
    "ci:build": "pnpm build",
    "ci:verify": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "audit:security": "pnpm audit --audit-level=moderate",
    "physics-registry": "node scripts/check-physics-registry.mjs",
    "science:backend:check": "python3 -m compileall -q services/science/science_backend",
    "science:backend:serve": "PYTHONPATH=services/science python3 -m uvicorn science_backend.api:create_app --factory --host 127.0.0.1 --port 8765",
    "science:backend:test": "PYTHONPATH=services/science python3 -m pytest services/science/tests",
    "science:verify": "node scripts/check-physics-registry.mjs && vitest run --config apps/browser/vitest.config.ts apps/browser/tests/science",
    "native:core:test": "source scripts/select-swift-toolchain.sh && swift test --package-path apps/apple/Packages/OtherlightCore",
    "native:science:test": "source scripts/select-swift-toolchain.sh && swift test --package-path apps/apple/Packages/OtherlightScience",
    "data:real-systems:refresh": "node scripts/fetch-real-systems-snapshot.mjs",
    "migrate:v4": "node scripts/migrate-systemparams-v4.mjs",
    "native:fixtures": "node scripts/export-native-parity-fixtures.mjs",
    "smoke:served": "bash ./scripts/smoke-served-app.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "10.1.0",
    "jsdom": "29.1.1",
    "prettier": "3.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "jscpd": "5.0.12",
    "knip": "6.27.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.0.16",
    "vitest": "4.1.1"
  }
}
