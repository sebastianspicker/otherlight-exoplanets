{
  "name": "Classroom Observatory",
  "register": "product",
  "theme": "light-shell-dark-plots",
  "colors": {
    "shell": "#f3f6f7",
    "surface": "#ffffff",
    "surfaceSubtle": "#e9eff1",
    "text": "#13242b",
    "textMuted": "#4b6069",
    "border": "#b8c6cb",
    "action": "#087f73",
    "signal": "#9a6200",
    "success": "#147a45",
    "warning": "#8a5a00",
    "error": "#b42318",
    "plot": "#09151d"
  },
  "typography": {
    "interface": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "data": "'SF Mono', 'SFMono-Regular', Menlo, Monaco, Consolas, monospace",
    "bodyPx": 15,
    "labelPx": 13
  },
  "radiusPx": {
    "small": 4,
    "control": 6,
    "region": 10,
    "dialog": 12
  },
  "motionMs": {
    "fast": 120,
    "normal": 180
  }
}
