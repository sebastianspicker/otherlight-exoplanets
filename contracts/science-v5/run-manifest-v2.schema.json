{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/transit-light-curve-lab/science-v5/run-manifest-v2.schema.json",
  "title": "Engine-neutral Scientific run manifest V2",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "inputHashSha256",
    "scientificResult",
    "implementation",
    "gravitationalConstantM3KgS2",
    "epochJdTdb",
    "startedAt",
    "completedAt",
    "capabilityManifestVersion",
    "modelVersions",
    "numericalTolerances",
    "datasets",
    "validityDomain",
    "warnings",
    "randomSeed",
    "artifact"
  ],
  "properties": {
    "schemaVersion": { "const": "science-run-manifest-v2" },
    "runId": { "type": "string", "minLength": 1 },
    "inputHashSha256": { "$ref": "#/$defs/sha256" },
    "scientificResult": { "const": true },
    "implementation": { "$ref": "#/$defs/implementation" },
    "gravitationalConstantM3KgS2": { "const": 6.6743e-11 },
    "epochJdTdb": { "type": "number", "exclusiveMinimum": 0 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "capabilityManifestVersion": { "type": "string", "minLength": 1 },
    "modelVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/idVersion" }
    },
    "numericalTolerances": { "$ref": "#/$defs/numericalTolerances" },
    "datasets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "validityDomain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "randomSeed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "artifact": {
      "type": "object",
      "required": ["idSha256", "format", "schemaVersion", "rowCount"],
      "properties": {
        "idSha256": { "$ref": "#/$defs/sha256" },
        "format": { "const": "arrow-ipc-file" },
        "schemaVersion": { "const": "radial-velocity-v1" },
        "rowCount": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "namedVersion": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "idVersion": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "numericalTolerances": {
      "type": "object",
      "required": [
        "requestedPositionToleranceM",
        "effectivePositionToleranceM",
        "requestedVelocityToleranceMps",
        "effectiveVelocityToleranceMps",
        "requestedRelativeTolerance",
        "effectiveRelativeTolerance",
        "requestedMaxStepSec",
        "effectiveMaxStepSec"
      ],
      "properties": {
        "requestedPositionToleranceM": { "type": "number", "exclusiveMinimum": 0 },
        "effectivePositionToleranceM": { "type": "number", "exclusiveMinimum": 0 },
        "requestedVelocityToleranceMps": { "type": "number", "exclusiveMinimum": 0 },
        "effectiveVelocityToleranceMps": { "type": "number", "exclusiveMinimum": 0 },
        "requestedRelativeTolerance": {
          "type": "number",
          "minimum": 2.220446049250313e-14,
          "exclusiveMaximum": 1
        },
        "effectiveRelativeTolerance": {
          "type": "number",
          "minimum": 2.220446049250313e-14,
          "exclusiveMaximum": 1
        },
        "requestedMaxStepSec": { "type": "number", "exclusiveMinimum": 0 },
        "effectiveMaxStepSec": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": ["application", "engine", "runtime", "artifactWriter", "platform"],
      "properties": {
        "application": {
          "type": "object",
          "required": ["name", "version", "build"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "engine": {
          "type": "object",
          "required": ["kind", "name", "version"],
          "properties": {
            "kind": { "enum": ["python-scipy", "swift-native"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "runtime": { "$ref": "#/$defs/namedVersion" },
        "artifactWriter": { "$ref": "#/$defs/namedVersion" },
        "platform": {
          "type": "object",
          "required": ["os", "architecture"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
