{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/transit-light-curve-lab/science-v7/resource-descriptor.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "science-resource-v7"
    },
    "resourceSchemaVersion": {
      "enum": ["science-v7", "workspace-v2", "opaque-bytes"]
    },
    "kind": {
      "enum": ["sources", "provenance", "observations", "calibrations", "scenarios", "workspaces"]
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    }
  },
  "required": ["schemaVersion", "resourceSchemaVersion", "kind", "hash", "byteLength"],
  "additionalProperties": false
}
