{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/transit-light-curve-lab/education-v4/scenario.schema.json",
  "title": "Scoped Education V4 scenario",
  "type": "object",
  "required": ["version", "mode", "runtime", "bodies", "orbits"],
  "properties": {
    "version": { "const": "4" },
    "mode": { "const": "general-lab" },
    "runtime": {
      "type": "object",
      "required": ["mode", "executionMode"],
      "properties": {
        "mode": { "const": "realtime" },
        "executionMode": { "const": "interactive" },
        "referenceSubsteps": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "observer": {
      "type": "object",
      "required": ["dir"],
      "properties": { "dir": { "$ref": "#/$defs/vector3" } },
      "additionalProperties": true
    },
    "bodies": {
      "type": "object",
      "required": ["stars", "planets", "moons"],
      "properties": {
        "stars": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/body" } },
        "planets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/orbitingBody" } },
        "moons": { "type": "array", "items": { "$ref": "#/$defs/orbitingBody" } }
      },
      "additionalProperties": false
    },
    "orbits": {
      "type": "object",
      "required": ["binary", "hierarchy"],
      "properties": {
        "binary": { "$ref": "#/$defs/orbit" },
        "hierarchy": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "photometry": { "type": "object" },
    "dynamics": { "type": "object" },
    "didactics": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "z": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": false
    },
    "orbit": {
      "type": "object",
      "required": ["a", "e", "inc", "Omega", "omega", "period", "t0"],
      "properties": {
        "a": { "$ref": "#/$defs/positiveNumber" },
        "e": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "inc": { "$ref": "#/$defs/finiteNumber" },
        "Omega": { "$ref": "#/$defs/finiteNumber" },
        "omega": { "$ref": "#/$defs/finiteNumber" },
        "period": { "$ref": "#/$defs/positiveNumber" },
        "t0": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": true
    },
    "body": {
      "type": "object",
      "required": ["id", "r", "m"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "r": { "$ref": "#/$defs/positiveNumber" },
        "m": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "orbitingBody": {
      "allOf": [
        { "$ref": "#/$defs/body" },
        {
          "type": "object",
          "required": ["orbit"],
          "properties": { "orbit": { "$ref": "#/$defs/orbit" } }
        }
      ]
    }
  }
}
