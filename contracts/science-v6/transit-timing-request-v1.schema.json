{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/otherlight/science-v6/transit-timing-request-v1.schema.json",
  "title": "Scientific V6 dense-trajectory transit timing request",
  "type": "object",
  "required": ["schemaVersion", "kind", "scenario", "window", "series", "datasetIds", "outputs", "seed"],
  "properties": {
    "schemaVersion": { "const": "science-transit-timing-request-v1" },
    "kind": { "const": "transit-timing" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "window": {
      "type": "object",
      "required": ["startOffsetSec", "endOffsetSec"],
      "properties": {
        "startOffsetSec": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "endOffsetSec": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/series" }
    },
    "datasetIds": { "type": "array", "maxItems": 0, "items": false },
    "outputs": {
      "type": "array",
      "prefixItems": [{ "const": "transit-events" }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "state": {
      "type": "object",
      "required": ["positionM", "velocityMps"],
      "properties": {
        "positionM": { "$ref": "#/$defs/vector3" },
        "velocityMps": { "$ref": "#/$defs/vector3" }
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "required": ["id", "kind", "massKg", "radiusM", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["star", "planet", "moon", "companion"] },
        "massKg": { "type": "number", "exclusiveMinimum": 0 },
        "radiusM": { "type": "number", "exclusiveMinimum": 0 },
        "state": { "$ref": "#/$defs/state" }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["schemaVersion", "id", "epochJdTdb", "timeScale", "bodies", "observer", "integrator"],
      "properties": {
        "schemaVersion": { "const": "v6" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "epochJdTdb": { "type": "number", "exclusiveMinimum": 0 },
        "timeScale": { "const": "TDB" },
        "bodies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/body" }
        },
        "observer": {
          "type": "object",
          "required": ["lineOfSight", "targetBodyId"],
          "properties": {
            "lineOfSight": { "$ref": "#/$defs/vector3" },
            "targetBodyId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "distanceM": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "integrator": {
          "type": "object",
          "required": [
            "method",
            "positionToleranceM",
            "velocityToleranceMps",
            "relativeTolerance",
            "maxStepSec"
          ],
          "properties": {
            "method": { "const": "DOP853" },
            "positionToleranceM": { "type": "number", "exclusiveMinimum": 0 },
            "velocityToleranceMps": { "type": "number", "exclusiveMinimum": 0 },
            "relativeTolerance": {
              "type": "number",
              "minimum": 2.220446049250313e-13,
              "exclusiveMaximum": 1
            },
            "maxStepSec": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["seriesId", "starBodyId", "occulterBodyId", "ephemeris", "referenceDurationT14Sec"],
      "properties": {
        "seriesId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,126}$" },
        "starBodyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "occulterBodyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ephemeris": {
          "type": "object",
          "required": ["referenceTransitIndex", "referenceMidTransitOffsetSec", "periodSec"],
          "properties": {
            "referenceTransitIndex": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "referenceMidTransitOffsetSec": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "periodSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000 }
          },
          "additionalProperties": false
        },
        "referenceDurationT14Sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000000 }
      },
      "additionalProperties": false
    }
  }
}
