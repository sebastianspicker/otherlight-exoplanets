{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/otherlight/science-v6/job-descriptor-v2.schema.json",
  "title": "Scientific V6 job descriptor",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "status", "createdAt", "updatedAt", "datasetIds"],
  "properties": {
    "schemaVersion": { "const": "science-job-descriptor-v2" },
    "id": { "type": "string", "pattern": "^job-[a-z0-9][a-z0-9-]{0,126}$" },
    "kind": { "const": "transit-timing" },
    "status": { "enum": ["queued", "running", "cancelled", "failed", "succeeded"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "datasetIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ds-[0-9a-f]{64}$" }
    },
    "error": { "$ref": "#/$defs/terminalError" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["error"] },
      "else": { "not": { "required": ["error"] } }
    }
  ],
  "$defs": {
    "terminalError": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "invalid-contract",
            "timing-geometry-indeterminate",
            "timing-ephemeris-ambiguous",
            "root-budget-exhausted",
            "numerical-convergence-failed",
            "wall-time-exhausted",
            "internal-error"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
