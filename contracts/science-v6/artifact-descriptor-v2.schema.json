{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/otherlight/science-v6/artifact-descriptor-v2.schema.json",
  "title": "Scientific V6 artifact descriptor",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "sha256",
    "kind",
    "dataSchemaVersion",
    "rowCount",
    "byteCount",
    "mediaType"
  ],
  "properties": {
    "schemaVersion": { "const": "science-artifact-descriptor-v2" },
    "artifactId": { "type": "string", "pattern": "^artifact-[0-9a-f]{64}$" },
    "sha256": { "$ref": "#/$defs/sha256" },
    "kind": { "enum": ["radial-velocity", "photometry-components", "transit-events"] },
    "dataSchemaVersion": {
      "enum": ["radial-velocity-v1", "photometry-components-v1", "transit-events-v1"]
    },
    "rowCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "byteCount": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "mediaType": { "const": "application/vnd.apache.arrow.file" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "radial-velocity" } },
        "required": ["kind"]
      },
      "then": { "properties": { "dataSchemaVersion": { "const": "radial-velocity-v1" } } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "photometry-components" } },
        "required": ["kind"]
      },
      "then": { "properties": { "dataSchemaVersion": { "const": "photometry-components-v1" } } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "transit-events" } },
        "required": ["kind"]
      },
      "then": { "properties": { "dataSchemaVersion": { "const": "transit-events-v1" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
